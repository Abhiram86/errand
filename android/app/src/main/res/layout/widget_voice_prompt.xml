<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_voice_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">

    <FrameLayout
        android:id="@+id/widget_mic_button"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_icon_background"
        android:contentDescription="Errand Voice">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:background="@drawable/widget_mic_button_bg">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_mic"
                android:contentDescription="Microphone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="6dp"
            android:layout_marginTop="6dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Errand" />
    </FrameLayout>
</FrameLayout>
