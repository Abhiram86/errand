<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon. Must be a single-colour (white on transparent)
  silhouette: Android tints the alpha channel and renders the image in the
  status bar's foreground colour only.

  The adaptive launcher icon (mipmap-anydpi-v26/ic_launcher.xml) is NOT valid
  here — adaptive icons have multiple layers and background/foreground, so they
  render as a blank blob or get dropped by stricter launchers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <!-- Rounded speech bubble: the agent reply mark. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4,3h16a2,2 0 0 1 2,2v10a2,2 0 0 1 -2,2H9l-5,4v-4H4a2,2 0 0 1 -2,-2V5a2,2 0 0 1 2,-2z" />
    <!-- Two dots: the "working" indicator inside the bubble. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M8,9.5m-1.4,0a1.4,1.4 0 1,0 2.8,0a1.4,1.4 0 1,0 -2.8,0z" />
    <path
        android:fillColor="#FF000000"
        android:pathData="M16,9.5m-1.4,0a1.4,1.4 0 1,0 2.8,0a1.4,1.4 0 1,0 -2.8,0z" />
    <!-- Underline: the pending-generation mark. -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M8,13h8v1.6h-8z" />
</vector>
